NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pulse
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# ICE servers served to authenticated clients at /api/calls/ice-servers
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN (required for users behind symmetric NAT / mobile carriers) - see deploy/coturn
TURN_URLS=
# --- Easiest free option: Cloudflare Realtime TURN (1,000 GB/month free, short-lived credentials) ---
# Cloudflare dashboard -> Realtime -> TURN Server -> Create. Copy the Key ID and API Token.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_TURN_TTL=86400
# --- Or Metered (20 GB/month free): TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
#     with TURN_USERNAME / TURN_CREDENTIAL from the Metered dashboard (Option B below)
# Option A: time-limited credentials (recommended) = coturn static-auth-secret
TURN_SECRET=
TURN_TTL=3600
# Option B: static credentials
TURN_USERNAME=
TURN_CREDENTIAL=

# Password-reset email (leave SMTP_HOST empty in dev: the link is printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pulse <no-reply@yourdomain.com>
UPLOAD_DIR=uploads

# Auto-delete chat data (messages, chats, notification previews) this many hours after it was created.
# 24 = one day (default). 0 = keep forever. Fractions are allowed (0.5 = 30 minutes).
# MongoDB's TTL monitor removes expired documents about once a minute; the API hides them immediately.
MESSAGE_TTL_HOURS=24
